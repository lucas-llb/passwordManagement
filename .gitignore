hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/

# Gradle wrapper must be committed
!**/gradle/wrapper/gradle-wrapper.jar

# .NET / Visual Studio
bin/
obj/
.vs/
*.user
TestResults/

# Android / Gradle / IDE
.gradle/
build/
local.properties
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/

# Secrets and real user data — never commit
*.jks
*.keystore
*.pfx
*.p12
*.pmvault
*.bak
*.pmvault.tmp
keystore.properties
*.csv
# ...except the fictitious samples used by both platforms' tests
!spec/test-vectors/**
