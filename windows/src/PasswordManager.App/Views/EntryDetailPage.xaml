<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PasswordManager.App.Views.EntryDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PasswordManager.App.Views"
    Loaded="OnLoaded">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Back is blocked while the draft has unsaved changes (the command's CanExecute); Escape goes through the same command.  -->
        <Button
            AutomationProperties.AutomationId="DetailBack"
            x:Uid="NavBack"
            Command="{x:Bind ViewModel.GoBackCommand}"
            KeyboardAcceleratorPlacementMode="Hidden">
            <Button.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" />
            </Button.KeyboardAccelerators>
        </Button>

        <!--  The page is always the editor: every field is bound to the draft on the view model, and the Tab order is the order below.  -->
        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="480" HorizontalAlignment="Left" Spacing="12">
                <TextBox
                    x:Name="DetailTitle"
                    AutomationProperties.AutomationId="DetailTitle"
                    x:Uid="DetailTitle"
                    IsSpellCheckEnabled="False"
                    IsTextPredictionEnabled="False"
                    Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    AutomationProperties.AutomationId="DetailUsername"
                    x:Uid="DetailUsername"
                    IsSpellCheckEnabled="False"
                    IsTextPredictionEnabled="False"
                    Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!--
                    The password is hidden by default. Only one of the two boxes is visible, and a collapsed element is not in the
                    UI Automation tree, so the password can be read through the tree only after "Mostrar senha". The PasswordBox has
                    no peek button of its own (Hidden): the toggle is the only way to show it.
                -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <PasswordBox
                            AutomationProperties.AutomationId="DetailPassword"
                            x:Uid="DetailPassword"
                            Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PasswordRevealMode="Hidden"
                            Visibility="{x:Bind ViewModel.IsPasswordHidden, Mode=OneWay}" />
                        <TextBox
                            AutomationProperties.AutomationId="DetailPasswordText"
                            x:Uid="DetailPasswordText"
                            IsSpellCheckEnabled="False"
                            IsTextPredictionEnabled="False"
                            Text="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{x:Bind ViewModel.IsPasswordVisible, Mode=OneWay}" />
                    </Grid>
                    <ToggleButton
                        Grid.Column="1"
                        AutomationProperties.AutomationId="DetailShowPassword"
                        x:Uid="DetailShowPassword"
                        VerticalAlignment="Bottom"
                        IsChecked="{x:Bind ViewModel.IsPasswordVisible, Mode=TwoWay}" />
                </Grid>

                <TextBox
                    AutomationProperties.AutomationId="DetailUrl"
                    x:Uid="DetailUrl"
                    IsSpellCheckEnabled="False"
                    IsTextPredictionEnabled="False"
                    Text="{x:Bind ViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    AutomationProperties.AutomationId="DetailFolder"
                    x:Uid="DetailFolder"
                    IsSpellCheckEnabled="False"
                    IsTextPredictionEnabled="False"
                    Text="{x:Bind ViewModel.Folder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    AutomationProperties.AutomationId="DetailNotes"
                    x:Uid="DetailNotes"
                    MinHeight="96"
                    AcceptsReturn="True"
                    IsSpellCheckEnabled="False"
                    IsTextPredictionEnabled="False"
                    Text="{x:Bind ViewModel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
                <CheckBox
                    AutomationProperties.AutomationId="DetailFavorite"
                    x:Uid="DetailFavorite"
                    IsChecked="{x:Bind ViewModel.Favorite, Mode=TwoWay}" />

                <TextBlock
                    AutomationProperties.AutomationId="DetailCreatedAt"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind local:EntryDetailPage.CreatedText(ViewModel.CreatedAt), Mode=OneWay}"
                    Visibility="{x:Bind local:EntryDetailPage.ShowWhenSaved(ViewModel.IsNew), Mode=OneWay}" />
                <TextBlock
                    AutomationProperties.AutomationId="DetailUpdatedAt"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind local:EntryDetailPage.UpdatedText(ViewModel.UpdatedAt), Mode=OneWay}"
                    Visibility="{x:Bind local:EntryDetailPage.ShowWhenSaved(ViewModel.IsNew), Mode=OneWay}" />

                <TextBlock
                    AutomationProperties.AutomationId="DetailTitleRequired"
                    x:Uid="DetailTitleRequired"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.IsTitleMissing, Mode=OneWay}" />
                <TextBlock
                    AutomationProperties.AutomationId="DetailSaveError"
                    x:Uid="DetailSaveError"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.SaveFailed, Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>

        <!--  Outside the scroll area, so the actions stay in reach with a long form. Save and Discard follow the draft (CanExecute).  -->
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="12">
            <Button
                AutomationProperties.AutomationId="DetailSave"
                x:Uid="DetailSave"
                Command="{x:Bind ViewModel.SaveCommand}"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                AutomationProperties.AutomationId="DetailDiscard"
                x:Uid="DetailDiscard"
                Command="{x:Bind ViewModel.DiscardCommand}" />
            <Button
                x:Name="DetailDelete"
                AutomationProperties.AutomationId="DetailDelete"
                x:Uid="DetailDelete"
                Click="OnDeleteClick"
                Visibility="{x:Bind local:EntryDetailPage.ShowWhenSaved(ViewModel.IsNew), Mode=OneWay}" />
        </StackPanel>

        <!--  Close is the default: Enter and Escape both cancel, so a delete always takes a deliberate choice.  -->
        <ContentDialog
            x:Name="DetailDeleteDialog"
            AutomationProperties.AutomationId="DetailDeleteDialog"
            x:Uid="DetailDeleteDialog"
            DefaultButton="Close"
            Style="{StaticResource DefaultContentDialogStyle}">
            <TextBlock
                MaxWidth="400"
                AutomationProperties.AutomationId="DetailDeleteWarning"
                x:Uid="DetailDeleteWarning"
                TextWrapping="Wrap" />
        </ContentDialog>
    </Grid>
</Page>
