<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PasswordManager.App.Views.EntryDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button x:Uid="NavBack" Command="{x:Bind ViewModel.GoBackCommand}" />

        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="480" HorizontalAlignment="Left" Spacing="12">
                <TextBox
                    x:Uid="DetailTitle"
                    IsReadOnly="True"
                    Text="{x:Bind ViewModel.Entry.Title}" />
                <TextBox
                    x:Uid="DetailUsername"
                    IsReadOnly="True"
                    Text="{x:Bind ViewModel.Entry.Username}" />
                <TextBox
                    x:Uid="DetailUrl"
                    IsReadOnly="True"
                    Text="{x:Bind ViewModel.Entry.Url}" />
                <TextBox
                    x:Uid="DetailFolder"
                    IsReadOnly="True"
                    Text="{x:Bind ViewModel.Entry.Folder}" />
                <TextBox
                    x:Uid="DetailNotes"
                    MinHeight="96"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    Text="{x:Bind ViewModel.Entry.Notes}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
