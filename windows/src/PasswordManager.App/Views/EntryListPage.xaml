<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PasswordManager.App.Views.EntryListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PasswordManager.App.Views"
    xmlns:vault="using:PasswordManager.Core.Vault"
    Loaded="OnLoaded">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                AutomationProperties.AutomationId="EntriesTitle"
                x:Uid="EntriesTitle"
                Style="{StaticResource TitleTextBlockStyle}" />
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    x:Name="NewEntryButton"
                    AutomationProperties.AutomationId="EntriesNew"
                    x:Uid="EntriesNew"
                    Command="{x:Bind ViewModel.NewEntryCommand}"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    AutomationProperties.AutomationId="EntriesLock"
                    x:Uid="EntriesLock"
                    Command="{x:Bind ViewModel.LockCommand}" />
            </StackPanel>
        </Grid>

        <!--  Search and filters. They live on the view model, so they survive the detail page; the Tab order follows this order.  -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                AutomationProperties.AutomationId="EntriesSearch"
                x:Uid="EntriesSearch"
                VerticalAlignment="Bottom"
                IsSpellCheckEnabled="False"
                IsTextPredictionEnabled="False"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox
                Grid.Column="1"
                AutomationProperties.AutomationId="EntriesFavoritesOnly"
                x:Uid="EntriesFavoritesOnly"
                VerticalAlignment="Bottom"
                IsChecked="{x:Bind ViewModel.FavoritesOnly, Mode=TwoWay}" />
            <ComboBox
                x:Name="FolderCombo"
                Grid.Column="2"
                MinWidth="200"
                AutomationProperties.AutomationId="EntriesFolder"
                x:Uid="EntriesFolder"
                VerticalAlignment="Bottom"
                SelectionChanged="OnFolderSelectionChanged" />
        </Grid>

        <ListView
            x:Name="EntriesList"
            Grid.Row="2"
            AutomationProperties.AutomationId="EntriesList"
            x:Uid="EntriesList"
            ContainerContentChanging="{x:Bind local:EntryListPage.OnEntryContainerContentChanging}"
            IsItemClickEnabled="True"
            ItemClick="OnEntryClick"
            ItemsSource="{x:Bind ViewModel.FilteredEntries, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vault:VaultEntry">
                    <StackPanel Margin="0,8">
                        <TextBlock AutomationProperties.AutomationId="EntryTitle" Text="{x:Bind Title}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Username}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            Grid.Row="2"
            AutomationProperties.AutomationId="EntriesEmpty"
            x:Uid="EntriesEmpty"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
        <TextBlock
            Grid.Row="2"
            AutomationProperties.AutomationId="EntriesNoMatches"
            x:Uid="EntriesNoMatches"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.HasNoMatches, Mode=OneWay}" />
    </Grid>
</Page>
