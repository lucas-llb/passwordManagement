<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PasswordManager.App.Views.EntryListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vault="using:PasswordManager.Core.Vault">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="EntriesTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <Button
                Grid.Column="1"
                x:Uid="EntriesLock"
                Command="{x:Bind ViewModel.LockCommand}" />
        </Grid>

        <ListView
            Grid.Row="1"
            IsItemClickEnabled="True"
            ItemClick="OnEntryClick"
            ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vault:VaultEntry">
                    <StackPanel Margin="0,8">
                        <TextBlock Text="{x:Bind Title}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Username}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            Grid.Row="1"
            x:Uid="EntriesEmpty"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
    </Grid>
</Page>
