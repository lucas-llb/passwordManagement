<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PasswordManager.App.Views.UnlockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PasswordManager.App.Views">

    <Grid Padding="24">
        <StackPanel
            MaxWidth="360"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">
            <TextBlock
                AutomationProperties.AutomationId="UnlockTitle"
                x:Uid="UnlockTitle"
                Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                AutomationProperties.AutomationId="UnlockProfileName"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.Profile.DisplayName}" />

            <PasswordBox
                x:Name="PasswordInput"
                AutomationProperties.AutomationId="UnlockPassword"
                x:Uid="UnlockPassword" />

            <TextBlock
                AutomationProperties.AutomationId="UnlockWrongPassword"
                x:Uid="UnlockWrongPassword"
                Visibility="{x:Bind local:UnlockPage.IsWrongPassword(ViewModel.Error), Mode=OneWay}" />
            <TextBlock
                AutomationProperties.AutomationId="UnlockVaultUnreadable"
                x:Uid="UnlockVaultUnreadable"
                Visibility="{x:Bind local:UnlockPage.IsVaultUnreadable(ViewModel.Error), Mode=OneWay}" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    AutomationProperties.AutomationId="UnlockButton"
                    x:Uid="UnlockButton"
                    Click="OnUnlockClick"
                    IsEnabled="{x:Bind local:UnlockPage.IsNot(ViewModel.UnlockCommand.IsRunning), Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    AutomationProperties.AutomationId="UnlockBack"
                    x:Uid="NavBack"
                    Command="{x:Bind ViewModel.GoBackCommand}" />
                <ProgressRing
                    Width="24"
                    Height="24"
                    IsActive="{x:Bind ViewModel.UnlockCommand.IsRunning, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
