<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PasswordManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- The navigation service of the ViewModels owns the stack, so the Frame keeps no history of its own. -->
    <Frame x:Name="RootFrame" IsNavigationStackEnabled="False" />
</Window>
