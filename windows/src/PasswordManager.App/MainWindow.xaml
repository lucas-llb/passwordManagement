<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PasswordManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="24">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <TextBlock x:Uid="ProfilesEmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock x:Uid="ProfilesEmptyHint" Style="{StaticResource BodyTextBlockStyle}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
