<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>PasswordManager.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <DefaultLanguage>pt-BR</DefaultLanguage>
    <!-- The version humans bump: this is the single human-facing source, and Package.appxmanifest Identity/@Version is
         its 4-part MSIX mirror (1.0.0 -> 1.0.0.0). PackageIdentityTests keeps the pair consistent. -->
    <Version>1.0.0</Version>
    <!-- Packaged by default: the MSIX targets switch on when Package.appxmanifest exists. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Symbol packages are declined for 1.0: the app has no crash reporting or telemetry (AGENTS.md §1 and §7) and
         the Store does not require them. This closes W-28's "symbols belong to W-30" note; the packaging targets warn
         without mspdbcmf.exe. -->
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <!-- Packaging runs ComputeFilesToPublish even on a plain build; Release trimming would run ILLink there
         (D5/W-29 own trimming), so collect publish items only when a package is actually produced. -->
    <IncludePublishItemsOutputGroup Condition="'$(GenerateAppxPackageOnBuild)'!='true'">false</IncludePublishItemsOutputGroup>
    <IncludePublishItemsOutputGroup Condition="'$(GenerateAppxPackageOnBuild)'=='true'">true</IncludePublishItemsOutputGroup>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- The release recipe builds one RID at a time with Platform=x64|ARM64. Keep the App artifacts under
         bin/<Configuration>/<tfm>/<rid>/ (no x64/ segment) so the documented publish path is stable; the referenced
         projects still separate their per-platform outputs. -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <!-- LibraryImport generates unsafe marshalling code (SYSLIB1062). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Ready to Run belongs to the release publish (tools/Publish-Release.ps1), never to a developer Release build:
         ILLink would run on every build and its task package would enter the restore graph, which is what rewrote
         packages.lock.json (W-29 / §13). Trimming is off by default because the Windows App SDK/WinRT assemblies are
         not trim-compatible (IL2104); the script's -Trim opts into it explicitly. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <!-- EnableMsixTooling puts PrepareMsixPackage into PrepareForRunDependsOn, so every Build runs MSIX's
       __BackCalculateOptimizationInputAssemblies. Its __SnapshotResolvedFileToPublishBeforeOptimization target runs
       BeforeTargets="CreateReadyToRunImages;ILLink" and triggers both before ComputeResolvedFilesToPublishList has
       populated ResolvedFileToPublish; with an empty item list they do nothing yet are cached as built, so the real
       publish then skips them and trimming/ReadyToRun silently no-op. Materialize the publish items first whenever the
       release publish enables an optimization; a plain developer build or packaging path sets neither property, so its
       target ordering is unchanged. -->
  <Target Name="_EnsurePublishItemsForOptimization"
          Condition="'$(PublishReadyToRun)' == 'true' or '$(PublishTrimmed)' == 'true'"
          BeforeTargets="__SnapshotResolvedFileToPublishBeforeOptimization;CreateReadyToRunImages;ILLink"
          DependsOnTargets="ComputeResolvedFilesToPublishList" />

  <ItemGroup>
    <ProjectReference Include="..\PasswordManager.Core\PasswordManager.Core.csproj" />
    <ProjectReference Include="..\PasswordManager.ViewModels\PasswordManager.ViewModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Symbol packages are declined for 1.0: drop the .pdb payload so the packaging targets never look for
       mspdbcmf.exe (this MSIX version warns regardless of AppxSymbolPackageEnabled). -->
  <Target Name="DisableAppxSymbolPackage" BeforeTargets="_EnsurePdbCmfExeFullPath">
    <ItemGroup>
      <PDBPayload Remove="@(PDBPayload)" />
    </ItemGroup>
  </Target>

</Project>
